flowchart LR
    subgraph LC["LeetCode Statuses"]
        LC_AC["Accepted"]
        LC_WA["Wrong Answer"]
        LC_TLE["Time Limit Exceeded"]
        LC_MLE["Memory Limit Exceeded"]
        LC_RE["Runtime Error"]
        LC_CE["Compile Error"]
    end

    subgraph HR["HackerRank Statuses"]
        HR_AC["Accepted"]
        HR_WA["Wrong Answer"]
        HR_TLE["Terminated due to timeout"]
        HR_RE["Runtime Error"]
        HR_CE["Compilation error"]
    end

    subgraph GFG["GFG Statuses"]
