        P_AC["ACCEPTED"]
        P_WA["WRONG_ANSWER"]
        P_TLE["TIME_LIMIT_EXCEEDED"]
        P_MLE["MEMORY_LIMIT_EXCEEDED"]
        P_RE["RUNTIME_ERROR"]
        P_CE["COMPILATION_ERROR"]
        P_SKIP["NOT a terminal state"]
    end

